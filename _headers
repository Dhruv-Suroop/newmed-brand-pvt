# Cloudflare. These stop the manual being embedded or sniffed if the URL leaks.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

# The AI skill page and the packs are meant to be reachable by assistants.
# noarchive still keeps them out of cached search results.
/ai
  X-Robots-Tag: noarchive
/ai.html
  X-Robots-Tag: noarchive
/assets/dl/*
  X-Robots-Tag: noarchive
